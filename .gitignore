*.hdf5
*.h5

# trained models / checkpoints
*.pt
*.pth

# python
__pycache__/
*.pyc
*.pyo

# outputs generated when running (keep classes-fixed.json, it's a source file)
src/*.png
src/complexity_ssm.json
